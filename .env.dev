# Dev-specific configuration for app/config.py's Settings.
#
# These are placeholder values for the devcontainer only - never real secrets, and
# never used in production. Loaded into the `app` service by
# .devcontainer/docker-compose.yml's `env_file` directive, so every command run
# inside the container (just backend/dev/test/migrate, and CI's just check, which
# reuses this same compose file) inherits them automatically.
#
# See app/config.py: these fields have no default - a real deployment must set its
# own values explicitly instead of silently inheriting a dev-only one.

ENVIRONMENT=dev

# Matches the `db` service in docker-compose.yml; papertrail/papertrail is that
# service's throwaway POSTGRES_USER/POSTGRES_PASSWORD.
DATABASE_URL=postgresql://papertrail:papertrail@db:5432/papertrail

# The obvious placeholder JWT signing secret - must match PLACEHOLDER_AUTH_SECRET
# in app/config.py, which refuses to boot with this value when ENVIRONMENT=prod.
AUTH_SECRET=dev-only-not-a-real-secret-change-me

# Origin the emailed verification / reset-password links point at (the frontend).
BASE_URL=http://localhost:3000

# Logs the verification / reset-password link instead of sending a real email.
EMAIL_BACKEND=console

# HTTPS-only cookies would break plain-HTTP localhost; production must set this true.
COOKIE_SECURE=false
